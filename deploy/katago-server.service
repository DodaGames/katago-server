[Unit]
Description=KataGo Analysis Server (uvicorn)
After=network.target

# 짧은 시간 안에 재시작이 반복되면(StartLimitBurst 회 이상) systemd가
# 더 이상 재시작을 시도하지 않고 멈춘다. 크래시 루프로 계속 재시작을
# 반복하며 문제를 숨기는 대신, 사람이 원인을 보게 만들기 위함이다.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jisupark
Group=jisupark
WorkingDirectory=/home/jisupark/Documents/project/doda/katago-server
ExecStart=/home/jisupark/Documents/project/doda/katago-server/scripts/run_prod.sh

# 크래시(미처리 예외, CUDA 에러 등) 시 자동 재시작.
# 사람이 `systemctl stop`으로 멈춘 경우는 재시작하지 않는다.
Restart=on-failure
RestartSec=5

# 그레이스풀 셧다운 시간(진행 중인 분석 요청 마무리 대기 후 SIGKILL).
KillSignal=SIGTERM
TimeoutStopSec=30

# 기본값이지만 명시: 유닛(cgroup) 전체에 신호를 보내 KataGo 엔진
# 자식 프로세스까지 함께 정리한다. 부모만 죽고 자식이 GPU 메모리를
# 물고 남는 상황(고아 프로세스)을 막기 위함.
KillMode=control-group

# 호스트 RAM 30GiB 중 24GiB를 상한으로 잡는다(20GiB부터 소프트 스로틀).
# OS/IDE 등 다른 프로세스를 위한 여유를 남겨두고, 커널의 전역 OOM killer가
# 무관한 프로세스를 죽이기 전에 이 cgroup을 먼저 정리하게 한다.
# 실측치를 보고 필요하면 조정할 것.
MemoryHigh=20G
MemoryMax=24G
OOMPolicy=stop

# stdout/stderr를 journald로 보낸다 (journalctl -u katago-server -f).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
