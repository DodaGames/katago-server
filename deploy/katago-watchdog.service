[Unit]
Description=KataGo Server Watchdog (single check)
# 알림 채널(Slack, Healthchecks.io)이 전부 아웃바운드 HTTP라 네트워크가 필요하다.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=jisupark
Group=jisupark
WorkingDirectory=/home/jisupark/Documents/project/doda/katago-server

# 감시 대상과 같은 venv를 쓰지 않는다. 그 venv가 깨지면 감시도 같이 죽기 때문에
# 워치독은 시스템 python3 + 표준 라이브러리만으로 돌아간다.
ExecStart=/usr/bin/python3 -m monitoring.watchdog
Environment=PYTHONPATH=/home/jisupark/Documents/project/doda/katago-server/src
Environment=PYTHONUNBUFFERED=1

# 알림 채널 URL/토큰은 커밋되지 않는 .env에 둔다.
# 파일이 없으면 무시되지만(- 접두사), 파싱할 수 없는 줄이 있으면 유닛이 실패한다.
# KEY=VALUE 형식만 쓸 것.
EnvironmentFile=-/home/jisupark/Documents/project/doda/katago-server/.env

# /var/lib/katago-watchdog 를 만들어 STATE_DIRECTORY 로 넘겨준다.
# 알림 지속시간 판정과 반복 억제에 필요한 상태 파일이 여기 쌓인다.
StateDirectory=katago-watchdog

# 한 번의 점검이 이보다 오래 걸리면 뭔가 잘못된 것이다(HTTP 타임아웃 5초 × 2 + systemctl).
TimeoutStartSec=60

StandardOutput=journal
StandardError=journal
